{
    "name": "vju/payment-client",
    "description": "Gói tích hợp Cổng thanh toán VJU cho app Laravel: tạo đơn, nhận webhook đã ký, kéo dự phòng /payments, fake để kiểm thử.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nesbot/carbon": "^2.72|^3.0",
        "vju/satellite-contracts": "^0.1.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/VJUVNU/satellite-contracts"
        }
    ],
    "autoload": {
        "psr-4": {
            "Vju\\PaymentClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vju\\PaymentClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vju\\PaymentClient\\PaymentGatewayServiceProvider"
            ],
            "aliases": {
                "PaymentGateway": "Vju\\PaymentClient\\Facades\\PaymentGateway"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
